default_platform(:ios)

platform :ios do
  desc "Tuist 프로젝트 생성"
  lane :generate do
    sh("tuist generate --no-open")
  end

  desc "SwiftLint 실행"
  lane :lint do
    swiftlint(
      mode: :lint,
      config_file: ".swiftlint.yml",
      strict: true
    )
  end

  desc "개발 빌드"
  lane :build do
    generate
    build_app(
      workspace: "Vellure.xcworkspace",
      scheme: "Vellure",
      configuration: "Debug",
      skip_codesigning: true,
      skip_archive: true
    )
  end

  desc "테스트 실행"
  lane :test do
    generate
    run_tests(
      workspace: "Vellure.xcworkspace",
      scheme: "Vellure",
      device: "iPhone 16",
      clean: true
    )
  end

  desc "TestFlight 배포"
  lane :beta do
    generate
    increment_build_number
    build_app(
      workspace: "Vellure.xcworkspace",
      scheme: "Vellure",
      configuration: "Release"
    )
    upload_to_testflight
  end

  desc "App Store 배포"
  lane :release do
    generate
    increment_build_number
    build_app(
      workspace: "Vellure.xcworkspace",
      scheme: "Vellure",
      configuration: "Release"
    )
    upload_to_app_store(
      skip_screenshots: true,
      skip_metadata: true
    )
  end
end
