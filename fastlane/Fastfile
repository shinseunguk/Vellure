default_platform(:ios)

platform :ios do
  # MARK: - Setup

  desc "Tuist 프로젝트 생성"
  lane :generate do
    sh("tuist generate --no-open --path ..")
  end

  desc "SwiftLint 실행"
  lane :lint do
    swiftlint(
      mode: :lint,
      config_file: ".swiftlint.yml",
      strict: true
    )
  end

  # MARK: - Build & Test

  desc "개발 빌드"
  lane :build do
    generate
    build_app(
      workspace: "Vellure.xcworkspace",
      scheme: "Vellure",
      configuration: "Debug",
      skip_codesigning: true,
      skip_archive: true
    )
  end

  desc "테스트 실행"
  lane :test do
    generate
    run_tests(
      workspace: "Vellure.xcworkspace",
      scheme: "Vellure",
      device: "iPhone 16",
      clean: true
    )
  end

  # MARK: - Distribution

  desc "TestFlight 배포"
  lane :beta do
    api_key = asc_api_key
    generate
    build_release(build_number: timestamp_build_number)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "App Store 배포"
  lane :release do
    api_key = asc_api_key
    generate
    build_release(build_number: timestamp_build_number)
    upload_to_app_store(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: true,
      # API 키 인증으로는 인앱 결제 precheck가 불가능해 제외한다
      precheck_include_in_app_purchases: false
    )
  end

  desc "메타데이터만 App Store Connect에 업로드 (바이너리/스크린샷 제외)"
  lane :upload_metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      force: true # HTML 미리보기 확인 생략
    )
  end

  desc "스크린샷만 App Store Connect에 업로드 (바이너리/메타데이터 제외)"
  lane :upload_screenshots do
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "match 인증서/프로파일 동기화 (최초 생성 및 갱신)"
  lane :certificates do
    asc_api_key
    match(type: "appstore")
  end

  # MARK: - Private

  desc "빌드 번호 생성 (YYYYMMDDHHMM)"
  private_lane :timestamp_build_number do
    Time.now.strftime("%Y%m%d%H%M")
  end

  desc "App Store Connect API 키 로드"
  private_lane :asc_api_key do
    if ENV["ASC_KEY_CONTENT"].to_s.empty?
      missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].select { |key| ENV[key].to_s.empty? }
      UI.user_error!("fastlane/.env에 #{missing.join(', ')} 값을 채워주세요.") unless missing.empty?
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: ENV["ASC_KEY_PATH"]
      )
    else
      # CI에서는 base64로 인코딩된 키 내용을 시크릿(ASC_KEY_CONTENT)으로 주입받는다
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: true
      )
    end
  end

  desc "Release 아카이브 빌드 (match 수동 서명)"
  private_lane :build_release do |options|
    UI.user_error!("fastlane/.env에 TEAM_ID 값을 채워주세요.") if ENV["TEAM_ID"].to_s.empty?

    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: ENV["CI"].to_s == "true")

    profile_by_target = {
      "Vellure" => "match AppStore dev.ukseung.Vellure",
      "VellureLiveActivity" => "match AppStore dev.ukseung.Vellure.VellureLiveActivity",
    }
    profile_by_target.each do |target, profile|
      update_code_signing_settings(
        path: "Vellure.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: ENV["TEAM_ID"],
        code_sign_identity: "Apple Distribution",
        profile_name: profile
      )
    end
    # 임베드되는 프레임워크는 프로파일 없이 배포 인증서로만 서명한다
    update_code_signing_settings(
      path: "Vellure.xcodeproj",
      targets: ["VellureCore", "VellureData", "VellurePresentation"],
      use_automatic_signing: false,
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      workspace: "Vellure.xcworkspace",
      scheme: "Vellure",
      configuration: "Release",
      export_method: "app-store",
      # 빌드 번호는 타임스탬프(YYYYMMDDHHMM)를 주입한다 (Tuist 재생성 시 초기화 방지)
      xcargs: "CURRENT_PROJECT_VERSION=#{options[:build_number]}",
      export_options: {
        provisioningProfiles: {
          "dev.ukseung.Vellure" => "match AppStore dev.ukseung.Vellure",
          "dev.ukseung.Vellure.VellureLiveActivity" => "match AppStore dev.ukseung.Vellure.VellureLiveActivity",
        },
      }
    )
  end
end
